# Copy to .env for docker-compose variable substitution.
# Never run services or toolchains on the host.

DRP_ENV=development
DRP_LOG_LEVEL=info
DRP_LOG_FORMAT=pretty
DRP_API_HOST=0.0.0.0
DRP_API_PORT=8080

# Infra (compose service hostnames — valid only inside the Docker network)
DRP_DATABASE_URL=postgres://drp:drp@postgres:5432/drp
DRP_REDIS_URL=redis://redis:6379
DRP_S3_ENDPOINT=http://minio:9000
DRP_S3_ACCESS_KEY=minioadmin
DRP_S3_SECRET_KEY=minioadmin
DRP_S3_BUCKET=drp
DRP_STORAGE_BACKEND=memory

POSTGRES_USER=drp
POSTGRES_PASSWORD=drp
POSTGRES_DB=drp
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
