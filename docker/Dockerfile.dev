# syntax=docker/dockerfile:1.6
# Development / CI toolchain image.
# Host machines never install Rust — all cargo/clippy/rustfmt/test run here.
FROM rust:1.85-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libssl-dev \
        curl \
        ca-certificates \
        git \
        cmake \
    && rm -rf /var/lib/apt/lists/*

# Pre-install the exact channel declared by rust-toolchain.toml so
# `docker-compose run` does not re-download the toolchain every invocation.
WORKDIR /tmp/drp-toolchain
COPY rust-toolchain.toml ./
RUN rustup show \
    && rustup component add rustfmt clippy rust-src \
    && rustc --version && cargo --version

WORKDIR /workspace

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH \
    CARGO_TERM_COLOR=always \
    DRP_IN_CONTAINER=1

CMD ["bash"]
