# syntax=docker/dockerfile:1.6
# Builds rustdoc inside a container and serves static HTML.
FROM rust:1.88-bookworm AS docs-builder

WORKDIR /app
COPY Cargo.toml rust-toolchain.toml rustfmt.toml clippy.toml ./
COPY crates ./crates

RUN cargo doc --workspace --no-deps --all-features --document-private-items

FROM nginx:1.27-alpine AS docs
COPY --from=docs-builder /app/target/doc /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
